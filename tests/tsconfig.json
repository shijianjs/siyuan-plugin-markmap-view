{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "resolveJsonModule": true,
        "strict": false,
        "skipLibCheck": true,
        "noEmit": true,
        "types": ["node"],
        "lib": ["ES2022", "DOM", "DOM.Iterable"]
    },
    "include": ["playwright.config.ts", "tests/**/*.ts", "../public/i18n/*.json"]
}